# Copy this file to .env and replace the placeholder secrets:
#   cp .env.example .env
# .env is git-ignored: never commit real credentials.

# PostgreSQL: metadata and audio features
POSTGRES_USER=soundscape
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soundscape
POSTGRES_PORT=5432

# S3-compatible object storage (RustFS): raw audio files
S3_ACCESS_KEY=soundscape-admin
S3_SECRET_KEY=change-me-too
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# Optional: these have defaults in src/soundscape/config.py
# POSTGRES_HOST=localhost
# S3_ENDPOINT_URL=http://localhost:9000   # leave empty to use AWS S3
# S3_BUCKET=soundscape
# S3_REGION=us-east-1
# INGEST_SOURCE_DIR=data/raw/birdclef/train_soundscapes
# INGEST_SOURCE_NAME=birdclef-2025
