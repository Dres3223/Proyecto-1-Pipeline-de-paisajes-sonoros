# Data: never committed (large files with their own license)
data/

# Audio in any folder (second safeguard in case a file ends up outside data/)
*.ogg
*.wav
*.mp3
*.flac

# Python environment
.venv/
__pycache__/
*.pyc

# Tool caches (pytest, ruff, coverage)
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Package builds (uv build)
dist/
build/
*.egg-info/

# Credentials
kaggle.json
access_token
.env
.env.*
!.env.example

# Airflow: run logs
logs/

# dbt: compiled files, downloaded packages and logs
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Terraform: state and .tfvars files may contain passwords and AWS keys
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Editors
.vscode/
.idea/

# macOS
.DS_Store
